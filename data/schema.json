{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/board-atlas/schema.json",
  "title": "Board Atlas brand file",
  "type": "array",
  "items": {
    "$ref": "#/$defs/product"
  },
  "$defs": {
    "url": {
      "type": "string",
      "pattern": "^https://"
    },
    "nullableText": {
      "type": [
        "string",
        "null"
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "season": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^20\\d{2}/\\d{2}$"
        },
        {
          "enum": [
            "待核实"
          ]
        }
      ]
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "brand",
        "model",
        "family",
        "season",
        "seasonEvidence",
        "shape",
        "shapeNote",
        "flex",
        "gender",
        "levels",
        "terrains",
        "recommendationBasis",
        "sizes",
        "fit",
        "price",
        "priceNote",
        "images",
        "source",
        "checkedAt",
        "status",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "brand": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "season": {
          "$ref": "#/$defs/season"
        },
        "seasonEvidence": {
          "type": "string",
          "minLength": 1
        },
        "shape": {
          "enum": [
            "True Twin",
            "Directional Twin",
            "Directional",
            null
          ]
        },
        "shapeNote": {
          "$ref": "#/$defs/nullableText"
        },
        "flex": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "kind",
            "original",
            "method",
            "source"
          ],
          "properties": {
            "value": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 1,
              "maximum": 10
            },
            "kind": {
              "enum": [
                "official",
                "converted",
                "unknown"
              ]
            },
            "original": {
              "$ref": "#/$defs/nullableText"
            },
            "method": {
              "$ref": "#/$defs/nullableText"
            },
            "source": {
              "anyOf": [
                {
                  "$ref": "#/$defs/url"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "gender": {
          "enum": [
            "Women",
            "Men",
            "Unisex",
            "Youth",
            null
          ]
        },
        "levels": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "入门",
              "进阶",
              "高手"
            ]
          }
        },
        "terrains": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "全山",
              "公园",
              "平花",
              "刻滑",
              "粉雪 / 自由滑"
            ]
          }
        },
        "recommendationBasis": {
          "type": "string",
          "minLength": 1
        },
        "sizes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^\\d{2,3}(\\.\\d+)?(W|MW|UW|N|SHUN|X|DF)?$"
          }
        },
        "fit": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "length",
              "weightKg",
              "source"
            ],
            "properties": {
              "length": {
                "type": "string"
              },
              "weightKg": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                }
              },
              "source": {
                "$ref": "#/$defs/url"
              }
            }
          }
        },
        "price": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "amount",
                "maxAmount",
                "currency",
                "region",
                "kind",
                "tax",
                "season",
                "checkedAt",
                "source"
              ],
              "properties": {
                "amount": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "maxAmount": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "currency": {
                  "type": "string",
                  "pattern": "^[A-Z]{3}$"
                },
                "region": {
                  "type": "string",
                  "minLength": 2
                },
                "kind": {
                  "enum": [
                    "official-list",
                    "msrp",
                    "official-display"
                  ]
                },
                "tax": {
                  "type": "string"
                },
                "season": {
                  "$ref": "#/$defs/season"
                },
                "checkedAt": {
                  "$ref": "#/$defs/date"
                },
                "source": {
                  "$ref": "#/$defs/url"
                },
                "startsAt": {
                  "type": "boolean",
                  "description": "官网仅公布起价；maxAmount等于amount时不代表已核实价格上限。"
                }
              }
            }
          ]
        },
        "priceNote": {
          "$ref": "#/$defs/nullableText"
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url",
              "source",
              "credit",
              "season",
              "label",
              "license"
            ],
            "properties": {
              "url": {
                "$ref": "#/$defs/url"
              },
              "source": {
                "$ref": "#/$defs/url"
              },
              "credit": {
                "type": "string",
                "minLength": 1
              },
              "season": {
                "$ref": "#/$defs/season"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "license": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "source": {
          "$ref": "#/$defs/url"
        },
        "checkedAt": {
          "$ref": "#/$defs/date"
        },
        "status": {
          "enum": [
            "reviewed",
            "partial"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "riderGender": {
          "type": "string",
          "enum": [
            "Men",
            "Women",
            "Unisex"
          ],
          "description": "厂家明确的男女适用定位；与Youth年龄分类独立。不填写时沿用gender。"
        },
        "shapeOriginal": {
          "type": "string",
          "minLength": 1,
          "description": "官方原生板型；不属于三分类时保留原名展示。"
        }
      }
    }
  }
}
